<% content_for :title, @query.present? ? "Search: #{@query}" : "Search" %>
<h1>Search</h1>
<%= form_with url: search_path, method: :get, class: "inline-form search-form", role: "search" do |form| %>
  <%= form.search_field :q, value: @query, autofocus: @query.blank?, aria: { label: "Search" }, placeholder: "Feature, customer, quote…" %>
  <%= form.submit "Search", class: "button", name: nil %>
<% end %>

<% if @query.length < 2 %>
  <p class="muted page-intro">Type at least two characters. Search covers insights, features, documents, feedback and customers.</p>
<% else %>
  <% results = { "Features" => @features, "Insights" => @insights, "Documents" => @documents, "Feedback" => @feedback_notes, "Customers" => @customers } %>
  <% results.each do |heading, records| %>
    <% next if records.empty? %>
    <section>
      <h2 class="section-title"><%= heading %></h2>
      <ul class="list">
        <% records.each do |record| %>
          <li class="list__item">
            <% case record %>
            <% when Feature %>
              <%= link_to record.title, record %><span class="muted small"><%= record.product.name %> · <%= money(record.demand_arr_cents) %> ARR asking</span>
            <% when Insight %>
              <%= link_to record.summary, record %><span class="muted small"><%= record.customer&.name || "Unknown customer" %></span>
            <% when Document %>
              <%= link_to record.title, record %><span class="muted small"><%= record.kind_name %></span>
            <% when FeedbackNote %>
              <%= link_to record.body.truncate(120), record %><span class="muted small"><%= time_ago_in_words(record.created_at) %> ago</span>
            <% when Customer %>
              <%= link_to record.name, record %><span class="muted small"><%= money(record.arr_cents) %> ARR</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <%= tag.p("Nothing matches “#{@query}”.", class: "empty") if results.values.all?(&:empty?) %>
<% end %>
