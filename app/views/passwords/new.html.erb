<% content_for :title, "Reset password" %>
<div class="card auth">
  <h1>Reset your password</h1>
  <p class="muted">We will email you a link to set a new password.</p>
  <%= render "shared/flash" %>
  <%= form_with url: passwords_path, class: "form" do |form| %>
    <label>Email<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %></label>
    <%= form.submit "Email reset link", class: "button button--primary" %>
  <% end %>
  <%= link_to "Back to sign in", new_session_path, class: "small" %>
</div>
