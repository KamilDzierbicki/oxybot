<% content_for :title, "Set a new password" %>
<div class="card auth">
  <h1>Set a new password</h1>
  <%= render "shared/flash" %>
  <%= form_with url: update_password_path(token: params[:token]), method: :patch, class: "form" do |form| %>
    <label>New password (<%= User::MIN_PASSWORD_LENGTH %>+ characters)<%= form.password_field :password, required: true, autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %></label>
    <label>Repeat it<%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %></label>
    <%= form.submit "Save password", class: "button button--primary" %>
  <% end %>
  <%= link_to "Back to sign in", new_session_path, class: "small" %>
</div>
