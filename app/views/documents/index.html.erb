<% content_for :title, "Documents" %>
<div class="page-header">
  <h1>Documents</h1>
  <%= link_to "Templates", document_templates_path, class: "button" %>
</div>
<p class="muted">The agent drafts these from your feedback, backlog and code. Specs and launch reviews start from a feature page.</p>
<div class="row create-row">
  <% { "voc_report" => "Voice of customer report", "opportunity_report" => "Opportunity report", "release_notes" => "Release notes" }.each do |kind, label| %>
    <%= button_to "New #{label.downcase}", documents_path, params: { kind: kind }, class: "button" %>
  <% end %>
</div>
<nav class="tabs">
  <%= link_to "All", documents_path, class: ["tab", ("tab--active" unless params[:kind])] %>
  <% Document::KINDS.each do |kind, name| %>
    <%= link_to name, documents_path(kind: kind), class: ["tab", ("tab--active" if params[:kind] == kind)] %>
  <% end %>
</nav>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Document</th><th>Kind</th><th>Feature</th><th>Status</th><th>Updated</th></tr></thead>
  <tbody>
    <% @documents.each do |document| %>
      <tr>
        <td><%= link_to document.title, document %></td>
        <td class="muted"><%= document.kind_name %></td>
        <td><%= document.feature ? link_to(document.feature.title, document.feature) : tag.span("–", class: "muted") %></td>
        <td><%= status_pill document.status %></td>
        <td class="muted"><%= time_ago_in_words(document.updated_at) %> ago</td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<%= tag.p("No documents yet.", class: "empty") if @documents.empty? %>
<%= render "shared/pagination", total_count: @total_count %>
