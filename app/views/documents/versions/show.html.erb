<% content_for :title, "Version · #{@document.title}" %>
<div class="page-header">
  <h1><%= @version.summary.presence || "Version #{@version.id}" %></h1>
  <div class="row">
    <%= link_to "All versions", document_versions_path(@document), class: "button" %>
    <% if @version.body != @document.body %>
      <%= button_to "Restore this version", document_version_restoration_path(@document, @version), class: "button button--primary",
                    form: { data: { turbo_confirm: "Make this version the current text? The current text stays in the history." } } %>
    <% end %>
  </div>
</div>
<p class="muted"><%= @version.author_name %> · <%= @version.created_at.to_fs(:long) %> · changes against the previous version (+<%= @diff.added_count %> / −<%= @diff.removed_count %>)</p>
<%= render "documents/diff", diff: @diff, label: "Changes in this version" %>
