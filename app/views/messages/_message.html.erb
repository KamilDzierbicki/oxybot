<div id="<%= dom_id(message) %>" class="message message--<%= message.role %> <%= "message--failed" if message.failed? %>">
  <% if message.thinking? %>
    <div id="<%= dom_id(message, :body) %>" class="message__body message__thinking" role="status"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> Looking through your feedback…</div>
  <% elsif message.assistant? %>
    <div class="message__body prose"><%= markdown(message.content, account: message.conversation.account) %></div>
    <div class="message__meta">
      AI-generated<%= " from #{message.tool_calls.map { |call| tool_label(call["name"]) }.uniq.to_sentence}" if message.tool_calls.any? %>. Check the cited insights.
    </div>
  <% else %>
    <div class="message__body"><%= simple_format(h(message.content)) %></div>
  <% end %>
</div>
