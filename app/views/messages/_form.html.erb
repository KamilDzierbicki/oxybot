<%= form_with url: conversation_messages_path(conversation), id: "message_form", class: "composer", data: { controller: "reset-on-submit", action: "turbo:submit-end->reset-on-submit#reset" } do |form| %>
  <%= form.text_area :question, rows: 2, required: true, placeholder: "Ask a follow-up…", class: "composer__input", aria: { label: "Ask OxyBot" },
                     data: { controller: "submit-on-enter", action: "keydown->submit-on-enter#submit" } %>
  <%= form.submit "Send", class: "button button--primary" %>
<% end %>
