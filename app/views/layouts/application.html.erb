<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · OpenSpark" : "OpenSpark" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="OpenSpark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <div class="shell">
        <nav class="sidebar">
          <div class="sidebar__brand">
            <span class="sidebar__logo">◆</span> OpenSpark
            <div class="sidebar__account"><%= Current.account.name %></div>
          </div>
          <%= nav_link "Assistant", conversations_path, active: controller_name.in?(%w[conversations messages]) %>
          <%= nav_link "Inbox", insights_path, count: Current.account.insights.pending.count, active: controller_name == "insights" %>
          <%= nav_link "Features", features_path, active: controller_name.in?(%w[features products specs launch_reviews linear_issues linear_simulations]) %>
          <%= nav_link "Documents", documents_path, active: controller_name.in?(%w[documents document_templates suggestions versions acceptances rejections regenerations]) %>
          <%= nav_link "Feedback", feedback_notes_path, active: controller_name == "feedback_notes" %>
          <%= nav_link "Customers", customers_path, active: controller_name == "customers" %>
          <%= nav_link "Knowledge", knowledge_documents_path, active: controller_name == "knowledge_documents" %>
          <%= nav_link "Skills", skills_path, active: controller_name == "skills" %>
          <%= nav_link "Integrations", integrations_path, active: controller_name.in?(%w[integrations simulated_messages syncs]) %>
          <div class="sidebar__footer">
            <%= link_to Current.user.name, profile_path %>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
          </div>
        </nav>
        <main class="main">
          <% flash.to_hash.slice("notice", "alert").each do |type, text| %>
            <div class="flash flash--<%= type %>"><%= text %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="main main--centered"><%= yield %></main>
    <% end %>
  </body>
</html>
