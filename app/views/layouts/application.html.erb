<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= safe_join([ content_for(:title), "OxyBot" ].compact_blank, " · ") %></title>
    <meta name="description" content="<%= content_for(:description).presence || "OxyBot turns customer feedback into cited product decisions: insights, demand by ARR, specs and release notes." %>">
    <meta property="og:title" content="<%= content_for(:title).presence || "OxyBot" %>">
    <meta property="og:description" content="Open-source product agent: customer feedback in, cited product decisions out.">
    <meta property="og:type" content="website">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="OxyBot">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <% if authenticated? %>
      <div class="shell">
        <nav class="sidebar" data-controller="menu" aria-label="Main">
          <div class="sidebar__top">
            <div class="sidebar__brand">
              <span class="sidebar__logo" aria-hidden="true">◆</span> OxyBot
              <div class="sidebar__account"><%= Current.account.name %></div>
            </div>
            <button type="button" class="button menu-toggle" aria-expanded="false" aria-controls="main-nav"
                    data-menu-target="button" data-action="menu#toggle">Menu</button>
          </div>
          <div class="sidebar__nav" id="main-nav">
            <%= form_with url: search_path, method: :get, class: "sidebar__search", role: "search" do |form| %>
              <%= form.search_field :q, value: (params[:q] if controller_name == "searches"), placeholder: "Search", aria: { label: "Search insights, features, feedback and documents" } %>
            <% end %>
            <%= nav_link "Assistant", conversations_path, active: controller_name.in?(%w[conversations messages]) %>
            <%= nav_link "Insights", insights_path, count: Current.account.insights.pending.count, active: controller_name.in?(%w[insights restorations]) && controller_path.start_with?("insights") %>
            <%= nav_link "Features", features_path, active: controller_name.in?(%w[features specs launch_reviews linear_issues linear_simulations]) %>
            <%= nav_link "Documents", documents_path, active: controller_name.in?(%w[documents document_templates suggestions versions acceptances rejections regenerations]) || controller_path == "documents/restorations" %>
            <div class="nav-group">Sources</div>
            <%= nav_link "Feedback", feedback_notes_path, active: controller_name.in?(%w[feedback_notes extractions]) %>
            <%= nav_link "Customers", customers_path, active: controller_name == "customers" %>
            <div class="nav-group">Agent context</div>
            <%= nav_link "Products", products_path, active: controller_name == "products" %>
            <%= nav_link "Knowledge base", knowledge_documents_path, active: controller_name == "knowledge_documents" %>
            <%= nav_link "Skills", skills_path, active: controller_name == "skills" %>
            <div class="nav-group">Settings</div>
            <%= nav_link "Integrations", integrations_path, active: controller_name.in?(%w[integrations simulated_messages syncs connection_checks]) %>
            <% if Current.user.admin? %>
              <%= nav_link "Users", users_path, active: controller_name.in?(%w[users invitations]) %>
              <%= nav_link "AI settings", ai_settings_path, active: controller_name.in?(%w[ai_settings prompt_refreshes]) %>
              <%= nav_link "Workspace", workspace_path, active: controller_name.in?(%w[workspaces exports]) %>
            <% end %>
          </div>
          <div class="sidebar__footer">
            <%= link_to Current.user.name, profile_path %>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
          </div>
        </nav>
        <main class="main" id="main">
          <%= render "shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% else %>
      <main class="main main--centered" id="main"><%= yield %></main>
    <% end %>
  </body>
</html>
