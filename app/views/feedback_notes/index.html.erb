<% content_for :title, "Feedback" %>
<div class="page-header">
  <h1>Feedback</h1>
  <%= link_to "Add feedback", new_feedback_note_path, class: "button button--primary" %>
</div>
<p class="muted">Raw feedback from Slack feedback channels and the form. Each note is split into insights automatically.</p>
<table class="table">
  <thead><tr><th>Feedback</th><th>Source</th><th>Customer</th><th>Insights</th><th>Received</th></tr></thead>
  <tbody>
    <% @feedback_notes.each do |note| %>
      <tr>
        <td><%= link_to note.body.truncate(110), note %></td>
        <td><%= status_pill note.source %></td>
        <td><%= note.customer&.name || tag.span("unknown", class: "muted") %></td>
        <td><%= note.processed? ? note.insights.size : tag.span("processing…", class: "muted") %></td>
        <td class="muted"><%= time_ago_in_words(note.created_at) %> ago</td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= tag.p("No feedback yet.", class: "empty") if @feedback_notes.empty? %>
