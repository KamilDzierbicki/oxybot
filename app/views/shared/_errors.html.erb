<% if record.errors.any? %>
  <div class="flash flash--alert" id="form-errors" role="alert">
    <% if record.errors.count == 1 %>
      <%= record.errors.full_messages.first %>
    <% else %>
      <p>Fix these to continue:</p>
      <ul class="error-list"><% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    <% end %>
  </div>
<% end %>
