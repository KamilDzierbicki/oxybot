<% if ENV["PRIVACY_POLICY_URL"].present? || ENV["TERMS_URL"].present? %>
  <p class="auth__legal">
    By continuing you agree to the
    <%= safe_join([ (link_to("terms", ENV["TERMS_URL"]) if ENV["TERMS_URL"].present?),
                    (link_to("privacy policy", ENV["PRIVACY_POLICY_URL"]) if ENV["PRIVACY_POLICY_URL"].present?) ].compact, " and ") %>.
  </p>
<% end %>
