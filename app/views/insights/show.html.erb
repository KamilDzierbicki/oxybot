<% content_for :title, "Insight ##{@insight.id}" %>
<div class="page-header">
  <h1><%= @insight.summary %></h1>
  <div class="row"><%= urgency_pill @insight.urgency %> <%= status_pill @insight.triage_state %></div>
</div>
<blockquote class="quote">“<%= @insight.quote %>”</blockquote>
<dl class="facts">
  <dt>Product</dt><dd><%= @insight.product.name %></dd>
  <dt>Customer</dt><dd><%= @insight.customer ? link_to("#{@insight.customer.name} · #{money(@insight.customer.arr_cents)} ARR", @insight.customer) : "Unknown" %></dd>
  <dt>Feature</dt><dd><%= @insight.feature ? link_to(@insight.feature.title, @insight.feature) : "Not linked" %></dd>
  <dt>Suggested</dt><dd><%= @insight.suggested_feature&.title || "Nothing" %> <span class="muted"><%= @insight.match_reason %></span></dd>
  <dt>Source</dt><dd><%= link_to "#{@insight.feedback_note.source.humanize} note", @insight.feedback_note %></dd>
</dl>
<% if @features.any? %>
  <%= form_with url: insight_link_path(@insight), class: "inline-form" do |form| %>
    <%= form.label :feature_id, "Feature", class: "visually-hidden" %>
    <%= form.select :feature_id, @features.map { |feature| [feature.title, feature.id] }, { selected: @insight.feature_id || @insight.suggested_feature_id }, required: true %>
    <%= form.submit @insight.linked? ? "Relink" : "Link", class: "button button--primary" %>
  <% end %>
<% end %>
<div class="row triage-row">
  <% if @insight.pending? %>
    <%= button_to "Dismiss", insight_dismissal_path(@insight), class: "button button--quiet" %>
  <% else %>
    <%= button_to "Move back to triage", insight_restoration_path(@insight), class: "button button--quiet" %>
  <% end %>
</div>
