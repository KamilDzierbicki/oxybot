<% content_for :title, "Sign in" %>
<div class="card auth">
  <div class="sidebar__brand"><span class="sidebar__logo" aria-hidden="true">◆</span> OxyBot</div>
  <h1>Sign in</h1>
  <p class="muted">The open-source product agent: customer feedback in, cited product decisions out.</p>
  <%= render "shared/flash" %>
  <%= form_with url: session_path, class: "form" do |form| %>
    <label>Email<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></label>
    <label>Password<%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></label>
    <%= form.submit "Sign in", class: "button button--primary" %>
  <% end %>
  <div class="auth__links"><%= link_to "Forgot password?", new_password_path %> <%= link_to "Create a workspace", new_signup_path %></div>
  <%= render "shared/legal_links" %>
</div>
