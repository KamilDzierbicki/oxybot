<%= form_with model: feature, class: "form" do |form| %>
  <%= render "shared/errors", record: feature %>
  <label>Title<%= form.text_field :title, required: true %></label>
  <div class="form__row">
    <label>Product<%= form.collection_select :product_id, Current.account.products.alphabetically, :id, :name, { selected: feature.product_id || Current.account.products.alphabetically.first&.id }, required: true %></label>
    <label>Status<%= form.select :status, Feature::STATUSES.map { |status| [status.humanize, status] } %></label>
  </div>
  <label>Description<%= form.text_area :description, rows: 4 %></label>
  <fieldset class="fieldset">
    <legend>Priority (RICE)</legend>
    <p class="form-hint">Reach is the number of customers asking, counted from linked insights. Set the other three to get a score.</p>
    <div class="form__row form__row--3">
      <label>Impact<%= form.select :impact, Feature::IMPACTS.map { |value, label| [label, value] }, { include_blank: "Not set" } %></label>
      <label>Confidence<%= form.select :confidence, Feature::CONFIDENCES.map { |value, label| [label, value] }, { include_blank: "Not set" } %></label>
      <label>Effort (person-weeks)<%= form.number_field :effort, min: 0.5, step: 0.5 %></label>
    </div>
  </fieldset>
  <%= form.submit "Save", class: "button button--primary" %>
<% end %>
