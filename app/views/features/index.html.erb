<% content_for :title, "Features" %>
<div class="page-header">
  <h1>Features by demand</h1>
  <div class="row">
    <%= link_to "Products", products_path, class: "button" %>
    <%= link_to "Add feature", new_feature_path(product: @product&.slug), class: "button button--primary" %>
  </div>
</div>
<% if @products.size <= 8 %>
  <nav class="tabs" aria-label="Products">
    <%= tab_link "All", features_path, @product.nil? %>
    <% @products.each do |product| %>
      <%= tab_link product.name, features_path(product: product.slug), product == @product %>
    <% end %>
  </nav>
<% else %>
  <%= form_with url: features_path, method: :get, class: "inline-form" do |form| %>
    <%= form.select :product, @products.map { |product| [ product.name, product.slug ] }, { include_blank: "All products", selected: @product&.slug },
                    aria: { label: "Filter by product" } %>
    <%= form.submit "Filter", class: "button", name: nil %>
  <% end %>
<% end %>
<div class="table-wrap">
<table class="table table--cards">
  <thead><tr><th>Feature</th><th class="num">ARR asking</th><th class="num">Customers</th><th class="num">Insights</th><th>Status</th><th>Product</th></tr></thead>
  <tbody>
    <% @features.each do |feature| %>
      <tr>
        <td class="table__title"><%= link_to feature.title, feature %></td>
        <td class="num" data-label="ARR asking"><strong class="arr"><%= money(feature.demand_arr_cents) %></strong></td>
        <td class="num" data-label="Customers"><%= feature.customer_count %></td>
        <td class="num" data-label="Insights"><%= feature.insight_count %></td>
        <td data-label="Status"><%= status_pill feature.status %></td>
        <td class="muted" data-label="Product"><%= feature.product.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<%= tag.p("No features yet.", class: "empty") if @features.empty? %>
<%= render "shared/pagination", total_count: @total_count %>
