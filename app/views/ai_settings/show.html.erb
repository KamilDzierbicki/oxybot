<% content_for :title, "AI settings" %>
<h1>AI settings</h1>
<p class="muted page-intro">Which AI model does each job, how matching behaves, and when the weekly report is drafted.</p>

<%= form_with model: @account, url: ai_settings_path, method: :patch, class: "form" do |form| %>
  <%= render "shared/errors", record: @account %>
  <h2 class="section-title section-title--flush">Models</h2>
  <p class="muted small">Each job runs on a model name from your LiteLLM gateway, which maps it to a provider and caps its daily spend.</p>
  <div class="form__row">
    <% Account::AiSettings::TASKS.each do |task, label| %>
      <% current = @account.ai_model(task) %>
      <label><%= label %><%= form.select "model_#{task}", (@models | [ current ]).sort, { selected: current }, required: true %></label>
    <% end %>
  </div>

  <h2 class="section-title">Daily budget</h2>
  <div class="form__row">
    <label>Daily AI budget for this workspace (USD)
      <%= form.number_field :daily_budget_usd, value: @account.ai_setting("daily_budget_usd"), min: 0, step: 0.5 %>
      <small class="muted">LiteLLM stops this workspace's model calls once the day's spend reaches it. 0 means no workspace limit; the per-model limits in LiteLLM still apply. Changes take effect within about a minute.</small></label>
    <div>
      <div class="stat__label">Spent today</div>
      <div class="stat__value"><%= @ai_spend_today ? number_to_currency(@ai_spend_today, precision: 2) : "Not available" %></div>
      <% unless LiteLlm.available? %><small class="muted">Runs on the built-in mock model, which costs nothing.</small><% end %>
    </div>
  </div>

  <h2 class="section-title">Weekly opportunity report</h2>
  <label class="checkbox"><%= form.check_box :weekly_report_enabled, checked: @account.ai_setting("weekly_report_enabled") %> Draft it every week<%= " and post it to your chat report channel" if @account.integrations.any?(&:chat?) %></label>
  <% unless @account.integrations.any?(&:chat?) %><p class="muted small">No Slack or Mattermost is connected, so the report is saved in Documents only.</p><% end %>
  <div class="form__row">
    <label>Day<%= form.select :weekly_report_day, Date::DAYNAMES.each_with_index.map { |day, index| [ day, index ] }, selected: @account.ai_setting("weekly_report_day") %></label>
    <label>Hour<%= form.select :weekly_report_hour, (0..23).map { |hour| [ format("%02d:00", hour), hour ] }, selected: @account.ai_setting("weekly_report_hour") %>
      <small class="muted">In the workspace time zone, <%= @account.time_zone %> (<%= link_to "change", workspace_path %>).</small></label>
  </div>

  <details class="advanced">
    <summary>Advanced: themes and limits</summary>
    <div class="form__row">
      <label>Theme grouping distance<%= form.number_field :theme_distance, value: @account.ai_setting("theme_distance"), min: 0.05, max: 0.9, step: 0.05 %>
        <small class="muted">For the weekly report. 0.05 groups only near-identical needs into a theme; 0.9 groups loosely related ones.</small></label>
      <label>Steps per answer<%= form.number_field :agent_max_rounds, value: @account.ai_setting("agent_max_rounds"), min: 1, max: 12 %>
        <small class="muted">How many lookups the assistant may make for one answer or document. A cap on cost and loops.</small></label>
    </div>
  </details>
  <div><%= form.submit "Save AI settings", class: "button button--primary" %></div>
<% end %>

<h2 class="section-title">Evaluation</h2>
<p class="small">
  <%= link_to "Evaluation cases", evaluation_cases_path %>: <%= pluralize(@account.evaluation_cases.pending.count, "correction") %> to review,
  <%= @account.evaluation_cases.approved.count %> approved for experiments.
</p>

<details class="advanced">
  <summary>Advanced: prompts</summary>
  <p class="muted small">
    <% if Prompt::Langfuse.configured? %>
      Prompts come from Langfuse (label <code><%= Prompt::LABEL %></code>) and are cached for 5 minutes; edit them in Langfuse. The files in <code>config/prompts</code> are the fallback.
    <% else %>
      Langfuse is not configured, so the files in <code>config/prompts</code> are used. Set LANGFUSE_URL and keys, then run <code>bin/rails langfuse:push_prompts</code> to edit prompts in Langfuse.
    <% end %>
    Search and matching use the <code><%= Embeddable::MODEL %></code> embedding model<%= " (#{@embedding_space.name})" if @embedding_space %>.
    If LiteLLM points it at another model, OxyBot notices and embeds everything again in the background.
    <% if @stale_vectors.positive? %><strong><%= pluralize(@stale_vectors, "record") %> still waiting to be embedded.</strong><% end %>
  </p>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Prompt</th><th>Source</th><th>Version</th></tr></thead>
    <tbody>
      <% @prompts.each do |prompt| %>
        <tr><td><code><%= prompt.name %></code></td><td><%= prompt.source == "langfuse" ? "Langfuse" : "File" %></td><td><%= prompt.version || "None" %></td></tr>
      <% end %>
    </tbody>
  </table>
  </div>
  <%= button_to "Reload prompts now", prompt_refresh_path, class: "button" if Prompt::Langfuse.configured? %>
</details>
