<% content_for :title, @integration.display_name %>
<% content_for :head do %><meta name="turbo-refresh-method" content="morph"><meta name="turbo-refresh-scroll" content="preserve"><% end %>
<%= turbo_stream_from @integration %>
<div class="page-header">
  <h1><%= @integration.display_name %></h1>
  <%= status_pill(@integration.mock? ? "test mode" : "live") %>
</div>
<% if @integration.mock? %>
  <p class="muted">Mock mode: no access token is set. <%= { "slack" => "Replies are recorded below instead of being posted to Slack.",
                                                            "mattermost" => "Replies are recorded below instead of being posted to Mattermost.",
                                                            "hubspot" => "Sync reads config/mocks/hubspot.yml instead of the HubSpot API.",
                                                            "linear" => "Issues are kept inside OxyBot instead of Linear.",
                                                            "github" => "The spec writer reads the sample repository in config/mocks/github." }[@integration.kind] %></p>
<% end %>

<div class="card row check-row">
  <% if @integration.last_checked_at %>
    <%= status_pill(@integration.last_check_ok ? "connected" : "failed") %>
    <span class="small"><%= @integration.last_check_message %> <span class="muted">(<%= time_ago_in_words(Time.zone.parse(@integration.last_checked_at)) %> ago)</span></span>
  <% else %>
    <span class="muted small">Connection not tested yet.</span>
  <% end %>
  <% if Current.user.admin? %>
    <%= button_to "Test connection", integration_connection_check_path(@integration), class: "button" %>
    <%= button_to "Disconnect", @integration, method: :delete, class: "button button--quiet", form: { data: { turbo_confirm: "Disconnect #{@integration.display_name}? Its settings and token are deleted." } } %>
  <% end %>
</div>

<%= render @integration.kind, integration: @integration %>
<%= render "integrations/#{@integration.kind}_setup" if lookup_context.exists?("integrations/_#{@integration.kind}_setup") %>
