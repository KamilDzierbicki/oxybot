<% content_for :title, @integration.display_name %>
<div class="page-header">
  <h1><%= @integration.display_name %></h1>
  <%= status_pill(@integration.mock? ? "mock" : "live") %>
</div>
<% if @integration.mock? %>
  <p class="muted">Mock mode: no access token is set. <%= @integration.is_a?(Integration::Slack) ? "Replies are recorded below instead of being posted to Slack." : "Sync reads config/mocks/hubspot.yml instead of the HubSpot API." %></p>
<% end %>

<%= render @integration.kind, integration: @integration %>
