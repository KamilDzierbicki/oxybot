<%= render "integrations/chat_simulator", integration: integration %>
<% if Current.user.admin? %>
<h2 class="section-title">Settings</h2>
<%= form_with model: integration, scope: :integration, url: integration_path(integration), method: :patch, class: "form" do |form| %>
  <div class="form__row">
    <label>Server address<%= form.text_field :server_url, placeholder: "https://chat.example.com" %></label>
    <label>Trigger word in channels<%= form.text_field :trigger_word, value: integration.trigger_word %></label>
  </div>
  <div class="form__row">
    <label>Feedback channel ids<%= form.text_field :feedback_channel_ids, value: Array(integration.feedback_channel_ids).join(", ") %></label>
    <label>Channel id for the weekly opportunity report<%= form.text_field :report_channel_id %></label>
  </div>
  <label>Bot access token<%= form.password_field :access_token, value: nil, placeholder: integration.mock? ? "Not set (mock mode)" : "Stored, leave empty to keep" %></label>
  <div class="form__row">
    <label>Outgoing webhook tokens (comma separated)<%= form.password_field :webhook_secret, value: nil, placeholder: integration.webhook_secret.present? ? "Stored, leave empty to keep" : "Not set" %></label>
    <label>Slash command token<%= form.password_field :command_token, value: nil, placeholder: integration.command_token.present? ? "Stored, leave empty to keep" : "Not set" %></label>
  </div>
  <%= form.submit "Save", class: "button" %>
<% end %>
<% end %>
