<div class="card">
  <p>Last sync: <strong><%= integration.synced_at ? "#{time_ago_in_words(integration.synced_at)} ago" : "never" %></strong>
     · <%= link_to "#{integration.account.customers.count} customers", customers_path %></p>
  <%= button_to "Sync now", integration_sync_path(integration), class: "button button--primary" %>
</div>
<h2 class="section-title">Settings</h2>
<%= form_with model: integration, scope: :integration, url: integration_path(integration), method: :patch, class: "form" do |form| %>
  <div class="form__row">
    <label>Company property with ARR<%= form.text_field :arr_property %></label>
    <label>Company property with plan<%= form.text_field :plan_property %></label>
  </div>
  <label>Private app access token<%= form.password_field :access_token, value: nil, placeholder: integration.mock? ? "Not set (mock mode)" : "Stored, leave empty to keep" %></label>
  <%= form.submit "Save", class: "button" %>
<% end %>
