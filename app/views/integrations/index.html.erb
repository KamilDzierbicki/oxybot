<% content_for :title, "Integrations" %>
<h1>Integrations</h1>
<p class="muted page-intro">A new integration starts in test mode: nothing leaves OxyBot, and you can try it with simulated messages. Add the real credentials on its page to go live.</p>
<div class="grid">
  <% { "slack" => "Feedback channels become feedback notes; DM the app or mention it to ask the agent. The weekly opportunity report is posted to a channel.",
       "mattermost" => "Self-hosted chat: feedback channels through outgoing webhooks, questions with @oxybot in channels or privately with /oxybot.",
       "hubspot" => "Companies with ARR and contacts sync every hour, so feedback is weighted by revenue.",
       "linear" => "Send features with their spec as issues; status syncs both ways through Linear's webhook.",
       "github" => "The spec writer searches your repository for technical context. Read-only." }.each do |kind, text| %>
    <% integration = @integrations[kind] %>
    <div class="card">
      <div class="insight__head"><strong><%= Integration.class_for(kind).new.display_name %></strong>
        <%= status_pill(integration.mock? ? "test mode" : "live") if integration %>
      </div>
      <p class="muted"><%= text %></p>
      <% if integration %>
        <%= link_to "Open", integration, class: "button card__actions" %>
      <% elsif Current.user.admin? %>
        <%= link_to "Connect", new_integration_path(kind: kind), class: "button card__actions" %>
      <% else %>
        <span class="muted small">Ask an admin to connect it.</span>
      <% end %>
    </div>
  <% end %>
</div>
