<% content_for :title, "Users" %>
<h1>Users</h1>
<p class="muted">Admins manage integrations, users, AI settings, team instructions, team skills and templates. Members use everything else. Chat ids link a person's Slack or Mattermost messages to their OxyBot account.</p>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Name</th><th>Role and chat ids</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %><%= tag.span(" (you)", class: "muted") if user == Current.user %><div class="muted small"><%= user.email_address %></div></td>
        <td>
          <%= form_with model: user, class: "inline-form inline-form--wrap" do |form| %>
            <%= form.select :role, User::ROLES.map { |role| [ role.humanize, role ] }, {}, aria: { label: "Role for #{user.name}" } %>
            <%= form.text_field :slack_user_id, placeholder: "Slack id", aria: { label: "Slack member id for #{user.name}" }, size: 12 %>
            <%= form.text_field :mattermost_user_id, placeholder: "Mattermost id", aria: { label: "Mattermost user id for #{user.name}" }, size: 14 %>
            <%= form.submit "Save", class: "button" %>
          <% end %>
        </td>
        <td><%= button_to "Remove", user, method: :delete, class: "button button--quiet", form: { data: { turbo_confirm: "Remove #{user.name}?" } } unless user == Current.user %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<h2 class="section-title">Invite someone</h2>
<% if flash[:invitation_url] %>
  <div class="card"><p class="small">If email is not set up yet, share this link (valid 7 days):</p><pre class="mono-block"><%= flash[:invitation_url] %></pre></div>
<% end %>
<%= render "shared/errors", record: @invitation if @invitation %>
<%= form_with model: @invitation || Invitation.new, class: "form invite-form" do |form| %>
  <div class="form__row">
    <label>Email<%= form.email_field :email, required: true, placeholder: "colleague@company.com" %></label>
    <label>Role<%= form.select :role, User::ROLES.map { |role| [ role.humanize, role ] }, { selected: @invitation&.role || "member" } %></label>
  </div>
  <p class="form-hint">Inviting an address again replaces its open invitation with a new link.</p>
  <div><%= form.submit "Send invitation", class: "button button--primary" %></div>
<% end %>
<% if @invitations.any? %>
  <h2 class="section-title">Pending invitations</h2>
  <ul class="list">
    <% @invitations.each do |invitation| %>
      <li class="list__item"><span><%= invitation.email %> <span class="muted">· <%= invitation.role %> · expires <%= invitation.expires_at.to_date.to_fs(:long) %></span></span>
        <%= button_to "Withdraw", invitation, method: :delete, class: "button button--quiet" %></li>
    <% end %>
  </ul>
<% end %>
