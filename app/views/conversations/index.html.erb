<% content_for :title, "Assistant" %>
<div class="hero">
  <h1>What do your customers need?</h1>
  <p class="muted">Ask about feedback, demand and the backlog. Answers cite the customer insights they come from.</p>
  <%= form_with url: conversations_path, class: "composer composer--large" do |form| %>
    <%= form.text_area :question, rows: 3, required: true, autofocus: true, class: "composer__input",
                       placeholder: "Which features have the most demand from enterprise customers?",
                       data: { controller: "submit-on-enter", action: "keydown->submit-on-enter#submit" } %>
    <%= form.submit "Ask", class: "button button--primary" %>
  <% end %>
  <div class="suggestions">
    <% ["Which features have the most demand?", "What do customers say about PDF export?", "Show the planned features"].each do |question| %>
      <%= button_to question, conversations_path, params: { question: question }, class: "chip" %>
    <% end %>
  </div>
</div>

<% if @conversations.any? %>
  <h2 class="section-title">Recent conversations</h2>
  <ul class="list">
    <% @conversations.each do |conversation| %>
      <li class="list__item">
        <%= link_to conversation.title.presence || "Untitled", conversation %>
        <span class="muted"><%= conversation.channel.humanize %> · <%= time_ago_in_words(conversation.updated_at) %> ago</span>
      </li>
    <% end %>
  </ul>
<% end %>
