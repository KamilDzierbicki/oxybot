# Copy to .env only when you want real models (docker compose --profile ai up -d).
# Without LITELLM_URL the app uses the built-in mock model and needs no keys.

# Provider keys, read by LiteLLM only (never by Rails)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Rails -> LiteLLM. The key is LiteLLM's master key from compose.yml.
LITELLM_URL=http://localhost:4010/v1
LITELLM_API_KEY=sk-openspark-local

# Rails -> Langfuse (traces). Keys are created by compose.yml on Langfuse's first start.
LANGFUSE_URL=http://localhost:3011
LANGFUSE_PUBLIC_KEY=pk-lf-openspark-local
LANGFUSE_SECRET_KEY=sk-lf-openspark-local

# Slack app signing secret (Basic Information page of the Slack app). Development has a local default.
SLACK_SIGNING_SECRET=

# Host used in links inside Slack replies
APP_HOST=localhost:3120
